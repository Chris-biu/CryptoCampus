# 复制为 .env 后按部署环境调整。不得提交真实口令、令牌、证书或私钥。
CRYPTOCAMPUS_VERSION=dev
CRYPTOCAMPUS_HTTP_PORT=8080
CRYPTOCAMPUS_CAMPUS_EMAIL_DOMAINS=campus.edu

# openHiTLS 与项目 bridge 在 Server 镜像构建阶段按固定提交编译并内置。
CRYPTOCAMPUS_SECRETS_DIR=./deploy/secrets
# 密信服务收件人必须是数据库中的 active 用户 UUID；私钥文件只读挂载。
CRYPTOCAMPUS_DROP_RECIPIENT_USER_ID=
CRYPTOCAMPUS_DROP_RECIPIENT_SM2_KEY_FILE=/run/secrets/cryptocampus/drop_recipient_sm2.key
CRYPTOCAMPUS_PLATFORM_CA_MANIFEST_FILE=/run/secrets/cryptocampus/platform_ca.json
CRYPTOCAMPUS_PLATFORM_CA_CERT_FILE=/run/secrets/cryptocampus/platform_ca.der
CRYPTOCAMPUS_PLATFORM_CA_KEY_FILE=/run/secrets/cryptocampus/platform_ca.key
CRYPTOCAMPUS_SEAL_MATERIAL_DIR=/run/secrets/cryptocampus/seal_materials
# 容器内只读 JWT 密钥文件；内容至少 32 个随机字节，不得提交到 Git。
CRYPTOCAMPUS_JWT_SECRET_FILE=/run/secrets/cryptocampus/jwt_secret
CRYPTOCAMPUS_HOLE_SIGNER_DIR=/run/secrets/cryptocampus/hole_signers
CRYPTOCAMPUS_SMTP_HOST=smtp.example.edu
CRYPTOCAMPUS_SMTP_PORT=587
CRYPTOCAMPUS_SMTP_USERNAME=cryptocampus@example.edu
CRYPTOCAMPUS_SMTP_FROM=cryptocampus@example.edu
CRYPTOCAMPUS_SMTP_PASSWORD_FILE=/run/secrets/cryptocampus/smtp_password
# 计票台身份、证书与 SM2 密钥目录；仅以只读 secret 挂载，不得提交真实材料。
CRYPTOCAMPUS_VOTE_TALLY_MATERIAL_DIR=/run/secrets/cryptocampus/vote_tally
CRYPTOCAMPUS_VOTE_SIGNER_DIR=/var/lib/cryptocampus/vote_signers

# 仅限本地演示：显式开启后可用固定验证码完成注册；生产环境会强制忽略。
CRYPTOCAMPUS_ENV=production
CRYPTOCAMPUS_ALLOW_DEMO_EMAIL=0
CRYPTOCAMPUS_DEMO_VERIFICATION_CODE=
